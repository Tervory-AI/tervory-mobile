{
  "name": "tervory-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "assets": "node scripts/assets.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "lint": "eslint . && node scripts/check-config.mjs",
    "test": "node --test tests/*.test.mjs",
    "sync": "npm run build && cap sync",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/push-notifications": "8.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "sharp": "0.35.5",
    "xcode": "4.0.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
